{
  "description": "create/from_template a draft, complete_line, transition an item, get, tags, void one issued in error. issue_invoice and record_invoice_paid post the ledger.",
  "type": "object",
  "required": [
    "op"
  ],
  "properties": {
    "op": {
      "type": "string",
      "enum": [
        "create",
        "from_template",
        "complete_line",
        "transition",
        "get",
        "tag",
        "untag",
        "tags",
        "find_by_tag",
        "void"
      ],
      "description": "create: customer+lines. from_template: customer+ctx. complete_line/transition: invoice_id+item_id. get: id or filters. tags: labels. void: invoice_id+reason."
    },
    "customer": {
      "type": "string",
      "description": "contact_id billed; get filter."
    },
    "reason": {
      "type": "string",
      "description": "void: why."
    },
    "lines": {
      "type": "array",
      "description": "credit at issue.",
      "items": {
        "type": "object",
        "required": [
          "account",
          "accountType",
          "amount"
        ],
        "properties": {
          "description": {
            "type": "string"
          },
          "account": {
            "type": "string"
          },
          "accountType": {
            "type": "string",
            "description": "REVENUE"
          },
          "amount": {
            "type": "number"
          }
        }
      }
    },
    "ctx": {
      "type": "object",
      "additionalProperties": true,
      "description": "from_template: quantities."
    },
    "template": {
      "type": "string",
      "description": "from_template: its name."
    },
    "due_date": {
      "type": "string",
      "description": "ISO date."
    },
    "memo": {
      "type": "string",
      "description": "on the invoice or transition."
    },
    "job": {
      "type": "string",
      "description": "job tag (per-job P&L)."
    },
    "location": {
      "type": "string",
      "description": "ordinal, default '1'."
    },
    "created_by": {
      "type": "string",
      "description": "account_id attributed."
    },
    "invoice_id": {
      "type": "string",
      "description": "the invoice."
    },
    "item_id": {
      "type": "string",
      "description": "the line, 'i0'…; transition may omit."
    },
    "state": {
      "type": "string",
      "description": "transition: paid|earned|refunded|own."
    },
    "dims": {
      "type": "object",
      "additionalProperties": true,
      "description": "transition: journal dims."
    },
    "transition_id": {
      "type": "string",
      "description": "transition: idempotency key."
    },
    "description": {
      "type": "string",
      "description": "complete_line: the line's text."
    },
    "unit_price": {
      "type": "number",
      "description": "complete_line: price for ONE."
    },
    "quantity": {
      "type": "number",
      "description": "complete_line: how many."
    },
    "account": {
      "type": "string",
      "description": "complete_line: where revenue lands."
    },
    "accountType": {
      "type": "string",
      "description": "complete_line: REVENUE or LIABILITY."
    },
    "catalog_item_id": {
      "type": "string",
      "description": "complete_line: the inventory item."
    },
    "status": {
      "type": "string",
      "description": "get: draft|issued|unpaid|paid|void."
    },
    "incomplete": {
      "type": "boolean",
      "description": "get: incomplete drafts."
    },
    "tag": {
      "type": "string",
      "description": "a label."
    }
  }
}
